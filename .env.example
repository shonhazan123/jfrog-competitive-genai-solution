# Copy this file to `.env` (same folder) and fill in the values you need, then
# restart:  docker compose down && docker compose up --build
#
# The app BOOTS without any of these. They are only needed for extra features.

# Required for "Run now" to gather live data (research agents + embeddings).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — only needed to send email digests (off by default).
# SMTP_APP_PASSWORD is a Gmail App Password, not your normal password.
SMTP_USER=
SMTP_APP_PASSWORD=
