<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Competitive digest — {{ persona }}</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      color: #1a1a1a;
      line-height: 1.5;
      margin: 0;
      padding: 24px;
      background-color: #f7f7f7;
    }
    .container {
      max-width: 640px;
      margin: 0 auto;
      background-color: #ffffff;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 24px;
    }
    h1 {
      font-size: 22px;
      margin: 0 0 8px;
      color: #0b3d91;
    }
    .persona {
      font-size: 14px;
      color: #555555;
      margin-bottom: 24px;
    }
    .item {
      border-bottom: 1px solid #eeeeee;
      padding: 16px 0;
    }
    .item:last-child {
      border-bottom: none;
    }
    .headline {
      font-size: 18px;
      font-weight: bold;
      margin: 0 0 8px;
    }
    .so-what {
      margin: 0 0 8px;
      color: #333333;
    }
    .link a {
      color: #0b3d91;
      text-decoration: none;
    }
    .empty {
      color: #666666;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Competitive digest — {{ persona }}</h1>
    <p class="persona">Prepared for the {{ persona }} team.</p>

    {% if items %}
      {% for item in items %}
        <div class="item">
          <p class="headline">{{ item.headline }}</p>
          <p class="so-what">{{ item.so_what }}</p>
          <p class="link">
            <a href="{{ app_base_url }}/signals/{{ item.signal_id }}">View signal</a>
          </p>
        </div>
      {% endfor %}
    {% else %}
      <p class="empty">No material competitive movement today.</p>
    {% endif %}
  </div>
</body>
</html>
