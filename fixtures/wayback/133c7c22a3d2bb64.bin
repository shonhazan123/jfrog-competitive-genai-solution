<div class="module--compare-table wrapped-x rounded-top rounded-bottom">
  <div class="module-wrapper container">
    <div class="row">
      <div class="col-12">
        <h2 class="text-center h3 my-4"></h2>
      </div>
    </div>
    <div class="row">
      <div class="col-12">
        <div class="rounded border shadow bg-white pt-3 text-body">
          
          <div class="mb-4 px-4">
            <div id="hs_cos_wrapper_dnd_area-module-4_" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_inline_rich_text" style="" data-hs-cos-general-type="widget" data-hs-cos-type="inline_rich_text" data-hs-cos-field="description"><div style="max-width: 1100px; margin: 20px auto;">
<h2 class="h3" style="text-align: center;">Sonatype’s data accuracy for DevOps automation is unmatched</h2>
<p style="text-align: center; font-size: 20px;"><span style="color: #0f1c4d;">The Sonatype Platform is 80% more accurate than JFrog. Teams feel empowered to innovate with complete pipeline control and our world-class support. Match the right risk to the right component, enforce policy, and remediate vulnerabilities with the world’s leading artifact repository manager.</span></p>
</div></div>
          </div>
          
          
          <table class="table d-none d-md-table align-middle m-0">
            <thead>
              <tr>
                <th class="p-3 fw-normal fs-5">Features</th>
                
                
                <th class="p-3 fw-normal fs-5">
                  
                  
                  <div>
                    
                    
                    
                    <img class="img-fluid" src="https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=200&amp;height=35&amp;name=Sonatype_logo_full_color.png" alt="Sonatype_logo_full_color" width="200" height="35" srcset="https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=100&amp;height=18&amp;name=Sonatype_logo_full_color.png 100w, https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=200&amp;height=35&amp;name=Sonatype_logo_full_color.png 200w, https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=300&amp;height=53&amp;name=Sonatype_logo_full_color.png 300w, https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=400&amp;height=70&amp;name=Sonatype_logo_full_color.png 400w, https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=500&amp;height=88&amp;name=Sonatype_logo_full_color.png 500w, https://www.sonatype.com/hs-fs/hubfs/2021%20Brand%20System/Sonatype_Press_Kit/Sonatype_logo_full_color.png?width=600&amp;height=105&amp;name=Sonatype_logo_full_color.png 600w" sizes="(max-width: 200px) 100vw, 200px">
                  </div>
                  
                  


                </th>
                
                <th class="p-3 fw-normal fs-5">
                  
                  
                  <div>
                    
                    
                    
                    <img class="img-fluid" src="https://www.sonatype.com/hubfs/integration-logos/JFrog-Artifactory-Logo.svg" alt="JFrog-Artifactory-Logo" width="180" height="180">
                  </div>
                  
                  


                </th>
                
                
              </tr>
            </thead>
            <tbody>
              
              <tr>
                <td class="p-3">Store and Manage Repositories</td>
                
                <td class="p-3">
                  
                  <span class="icon-feature-yes me-2" aria-hidden="true">
                    
                    <svg width="17" height="12" viewbox="0 0 17 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.00195 5.30178L6.76148 10.5L15.002 1.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    
                  </span>
                  <span class="visually-hidden">yes</span>
                  
                  
                  <span class="text-black-50">Yes</span>
                  
                  
                </td>
                
                <td class="p-3">
                  
