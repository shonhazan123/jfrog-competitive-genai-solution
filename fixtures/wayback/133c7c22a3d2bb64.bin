<div class="row-fluid-wrapper row-depth-1 row-number-2 dnd-row">
<div class="row-fluid ">
<div class="span12 widget-span widget-type-custom_widget dnd-module" style="" data-widget-type="custom_widget" data-x="0" data-w="12">
<div id="hs_cos_wrapper_dnd_area-module-2" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module" style="" data-hs-cos-general-type="widget" data-hs-cos-type="module">


    




    







<div class="module--styles d-none" data-target=".dnd-column"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const module = document.getElementById("hs_cos_wrapper_dnd_area-module-2");
        if (module) {
            const target = module.closest('.dnd-column');
            if (target) {
                const margins = ("wrapped-x").split(" ");
                const rounding = ("rounded-top rounded-bottom").split(" ");
                const classes = ("container").split(" ");
                const styles = "margin: 0 auto!important; float: none;";

                let newClasses = ['targeted-style--dnd_area-module-2'];

                if (classes.length)
                    newClasses = newClasses.concat(classes);
                if (margins.length)
                    newClasses = newClasses.concat(margins);
                if (rounding.length)
                    newClasses = newClasses.concat(rounding);

                newClasses = newClasses.filter((item) => item !== "");

                if (styles.length)
                    target.setAttribute("style", styles);

                target.classList.add(...newClasses);
            }
        }
    });
</script></div>

</div><!--end widget-span -->
</div><!--end row-->
</div><!--end row-wrapper -->

