</div><!--end widget-span -->
<div class="span4 widget-span widget-type-custom_widget shadow-border" style="margin-bottom:10px;" data-widget-type="custom_widget" data-x="4" data-w="4">
<div id="hs_cos_wrapper_module_15568924278871064" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module" style="" data-hs-cos-general-type="widget" data-hs-cos-type="module"><div class="center-align" style="padding-top:0px; padding-bottom:0px;">
    <div class="row-fluid">
        <div class="span12" style="padding-top:0px; padding-bottom:30px;">
            
    	        <img class="lazy2" data-src="https://www.sonatype.com/hubfs/SON_WebPage_Image_Automated_Security@2x.png" width="600" height="500" alt="SON_WebPage_Image_Automated_Security@2x">
            
        </div>
    </div>
    <div class="row-fluid">
        <div class="span12" style="padding-top:30px; padding-bottom:57px; color:#1d1d1d;">
            <div style="text-align: center;"><span style="font-size: 14pt; color: #1b1b1b; margin-bottom: 20px;">Enforce open source policies across your entire SDLC with the Nexus Platform</span></div>
        </div>
