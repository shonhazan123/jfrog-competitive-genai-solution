                <p class="card-title my-0 text-gradient-primary"></p>
                <div class="card-description my-0"><a href="https://www.gartner.com/reviews/market/software-composition-analysis-sca/vendor/sonatype" rel="noopener" target="_blank"><img src="https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=256&amp;height=140&amp;name=Gartner-badge@2x.png" alt="Gartner Badge" width="256" height="140" loading="lazy" style="height: auto; max-width: 100%; width: 256px; margin-left: auto; margin-right: auto; display: block;" srcset="https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=128&amp;height=70&amp;name=Gartner-badge@2x.png 128w, https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=256&amp;height=140&amp;name=Gartner-badge@2x.png 256w, https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=384&amp;height=210&amp;name=Gartner-badge@2x.png 384w, https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=512&amp;height=280&amp;name=Gartner-badge@2x.png 512w, https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=640&amp;height=350&amp;name=Gartner-badge@2x.png 640w, https://www.sonatype.com/hs-fs/hubfs/1-2023%20New%20Site%20Assets/Customer%20Logos/Gartner-badge@2x.png?width=768&amp;height=420&amp;name=Gartner-badge@2x.png 768w" sizes="(max-width: 256px) 100vw, 256px"></a></div>
              </div>
              
              <div class="accent-bar" style="background-color: ;"></div>
            </div>
          </div>
          
          <div class="card-col col-12 col-lg-4 col-md-12 g-0">
            <div class="card h-100 p-3 p-md-4 mx-0 text-center d-flex flex-column justify-content-between align-items-center">
