  footer.wmxfooter > svg {
    position: absolute;
    top: 0;
    transform: translateY(calc(-100% + 20px));
    left: 0;
    width: 100%;
    height: 100px;
  }
  footer.wmxfooter > svg rect {
    fill: none;
  }
  footer.wmxfooter .container {
    position: relative;
  }
  footer.wmxfooter .container .row-footer-logo {
