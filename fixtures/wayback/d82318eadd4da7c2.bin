  $('.btn[data-bs-toggle="modal"]').click(function() {
    var property = $(this).attr('data-property');
    var option = $(this).attr('data-option');
    var modalSelector = $(this).attr('data-bs-target');

    $(modalSelector).find('input[type="checkbox"][name="'+ property +'"]').prop('checked', false);
    $(modalSelector).find('input[type="checkbox"][name="'+ property +'"][value="'+ option +'"]').prop('checked', true);
  });

  
</script>

